{
  "name": "antigravity-cursor-bridge",
  "version": "1.0.0",
  "description": "Bridge Antigravity models (Gemini 3.8 Flash High, Claude 4.6 Thinking) directly into Cursor IDE with a local management dashboard.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "vite build",
    "dev:client": "vite",
    "token": "node scripts/generateToken.js",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "keywords": [
    "antigravity",
    "cursor",
    "gemini",
    "claude",
    "ai-proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
