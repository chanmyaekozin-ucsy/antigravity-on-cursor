# =================================================================
# Antigravity Cursor Bridge & Dashboard Configuration
# =================================================================

# Server Port (Default: 8045)
PORT=8045

# Dashboard Authentication (HTTP Basic Auth)
# When set, accessing the web dashboard (http://localhost:8045/) and management APIs
# requires entering this username and password in the browser.
# Note: Cursor IDE API endpoints (/v1/*) use API Keys and are NOT blocked by this.
# Leave blank or commented out to disable authentication.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Public Tunnel Control
# Tunnels are opt-in. Create an API key in the dashboard before enabling one.
ENABLE_TUNNEL=false
DISABLE_TUNNEL=true

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Same-origin dashboard requests and Cursor's server-side requests work automatically.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opt in only when troubleshooting request-shape issues. This logs prompt snippets.
VERBOSE_REQUEST_LOGS=false

# Keep false for VPS use: Cursor owns conversation/tool state and the VPS is only the model brain.
# Enabling this may allow stale Antigravity Cascade agent state to leak across Cursor tool turns.
ANTIGRAVITY_SESSION_REUSE=false
