# =================================================================
# Antigravity Cursor Bridge & Dashboard Configuration
# =================================================================

# Server Port (Default: 8045)
PORT=8045

# Dashboard Authentication (HTTP Basic Auth)
# When set, accessing the web dashboard (http://localhost:8045/) and management APIs
# requires entering this username and password in the browser.
# Note: Cursor IDE API endpoints (/v1/*) use API Keys and are NOT blocked by this.
# Leave blank or commented out to disable authentication.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

# Public Tunnel Control
# Set to true to disable the Serveo / Cloudflare SSH public tunnel
DISABLE_TUNNEL=false
